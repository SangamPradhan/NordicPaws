<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/itemMainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main Task Header Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Icon Badge -->
            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_input">

                <ImageView
                    android:id="@+id/taskIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_restaurant_24"
                    app:tint="@color/primary_black" />
            </FrameLayout>

            <!-- Task Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/taskTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plusjakartasanssemibold"
                    android:text="Morning Organic Kibble"
                    android:textColor="@color/primary_black"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/taskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasanssemibold"
                        android:text="08:00 AM"
                        android:textColor="@color/neutral_slate"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/bg_logo_circle" />

                    <TextView
                        android:id="@+id/taskRecurrenceTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasansbold"
                        android:text="DAILY"
                        android:textAllCaps="true"
                        android:textColor="@color/neutral_slate"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/taskCheckbox"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_checkbox_rounded"
                    android:button="@null"
                    android:focusable="false"
                    android:clickable="true"/>

                <ImageButton
                    android:id="@+id/btnMore"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/baseline_more_vert_24"
                    app:tint="@color/neutral_slate" />
            </LinearLayout>

        </LinearLayout>

        <!-- Expandable Details View (Revealed on click) -->
        <LinearLayout
            android:id="@+id/expandableDetailsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSTRUCTIONS &amp; NOTES"
                android:textColor="@color/neutral_slate"
                android:textSize="10sp"
                android:fontFamily="@font/plusjakartasansbold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/taskNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="1.5 scoops kibble mixed with digestive probiotic powder. Fresh water refilled."
                android:textColor="@color/primary_black"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/taskCategoryTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_input"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Feeding"
                    android:textColor="@color/primary_black"
                    android:textSize="11sp"
                    android:fontFamily="@font/plusjakartasansbold"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/taskStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENDING"
                    android:textColor="@color/neutral_slate"
                    android:textSize="11sp"
                    android:fontFamily="@font/plusjakartasansbold"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
