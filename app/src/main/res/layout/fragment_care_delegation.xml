<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_action_bar"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/btnBackDelegation"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bottom_nav"
                    android:src="@drawable/baseline_arrow_back_24"
                    android:padding="8dp"
                    app:tint="@color/primary_black"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="Delegate Routine"
                    android:textColor="@color/primary_black"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Pet & Date Selector Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasansbold"
                        android:text="SELECT PET &amp; DELEGATION DATE"
                        android:textColor="@color/neutral_slate"
                        android:textSize="10sp"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="12dp" />

                    <!-- Pet Switcher Row -->
                    <LinearLayout
                        android:id="@+id/delegationPetPill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:layout_marginBottom="10dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/delegationPetAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/dog" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/delegationPetName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/plusjakartasansbold"
                            android:text="Select Pet"
                            android:textColor="@color/primary_black"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/baseline_more_vert_24"
                            app:tint="@color/neutral_slate" />
                    </LinearLayout>

                    <!-- Date Picker Row -->
                    <LinearLayout
                        android:id="@+id/delegationDatePickerPill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_event_note_24"
                            app:tint="@color/neutral_slate" />

                        <TextView
                            android:id="@+id/tvDelegationDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/plusjakartasansbold"
                            android:text="Select Date"
                            android:textColor="@color/primary_black"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDelegationTasksCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_input"
                            android:backgroundTint="@color/secondary_yellow"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="0 Tasks"
                            android:textColor="@color/primary_black"
                            android:textSize="11sp"
                            android:fontFamily="@font/plusjakartasansbold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recipient Phone Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plusjakartasansbold"
                android:text="Recipient Phone Number"
                android:textColor="@color/primary_black"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_recipient_phone"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="Enter phone number"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:textColorHint="@color/neutral_slate"
                    android:textColor="@color/primary_black"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans_regular" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_pick_contact"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_rounded_input">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_person_24"
                            app:tint="#F97316" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/plusjakartasansbold"
                            android:text="Contacts"
                            android:textColor="#F97316"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Tasks Checklist Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="Tasks Checklist"
                    android:textColor="@color/primary_black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="Deselect All"
                    android:textColor="#F97316"
                    android:textSize="12sp"
                    android:paddingVertical="4dp"
                    android:paddingStart="8dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_delegation_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="No tasks available for this date."
                android:textColor="@color/neutral_slate"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (Floating Delegate Button) -->
    <FrameLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="90dp"
        android:paddingBottom="12dp"
        android:paddingTop="12dp"
        android:background="@android:color/transparent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSendDelegation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_welcome_button"
            android:backgroundTint="@color/primary_black"
            android:drawableEnd="@drawable/send"
            android:drawableTint="@color/surface_white"
            android:elevation="4dp"
            android:fontFamily="@font/plusjakartasansbold"
            android:paddingStart="40dp"
            android:paddingEnd="24dp"
            android:text="Delegate via SMS"
            android:textAllCaps="false"
            android:textColor="@color/surface_white"
            android:textSize="16sp" />
    </FrameLayout>
</RelativeLayout>
