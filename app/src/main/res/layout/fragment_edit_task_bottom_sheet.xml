<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Handle bar -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_logo_circle"
            android:backgroundTint="#CBD5E1" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plusjakartasansbold"
                android:text="Edit Activity"
                android:textColor="@color/primary_black"
                android:textSize="20sp" />

            <!-- Pet Switcher Banner Pill -->
            <LinearLayout
                android:id="@+id/editPetSelectorPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/editSelectedPetAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dog" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/editSelectedPetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="Milo"
                    android:textColor="@color/primary_black"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/baseline_more_vert_24"
                    app:tint="@color/neutral_slate" />
            </LinearLayout>
        </LinearLayout>

        <!-- Category Horizontal Scroll Area -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="CARE DOMAIN"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/editCategoryChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Dynamically populated chips -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Task Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="TASK TITLE"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEditTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_input"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:hint="Task title"
            android:paddingHorizontal="16dp"
            android:textColor="@color/primary_black"
            android:textColorHint="@color/neutral_slate"
            android:textSize="14sp"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />

        <!-- Recurrence Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="RECURRENCE PATTERN"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnEditRecurrenceDaily"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_input"
                    android:backgroundTint="@color/secondary_yellow"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Daily"
                    android:textColor="@color/primary_black"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnEditRecurrenceWeekly"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_input"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Weekly"
                    android:textColor="@color/neutral_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnEditRecurrenceMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_input"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Monthly"
                    android:textColor="@color/neutral_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnEditRecurrenceSpecificDate"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_rounded_input"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Specific Date (Vet/One-time)"
                    android:textColor="@color/neutral_slate"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Time & Date Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Time Picker Pill -->
            <LinearLayout
                android:id="@+id/editTimePickerPill"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/baseline_event_note_24"
                    app:tint="@color/neutral_slate" />

                <TextView
                    android:id="@+id/tvEditScheduledTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="08:00 AM"
                    android:textColor="@color/primary_black"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Date Picker Pill -->
            <LinearLayout
                android:id="@+id/editDatePickerPill"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/baseline_event_note_24"
                    app:tint="@color/neutral_slate" />

                <TextView
                    android:id="@+id/tvEditScheduledDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="Select Date"
                    android:textColor="@color/primary_black"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Instructions Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="NUTRITION &amp; CARE DETAILS"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEditTaskNotes"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_rounded_input"
            android:gravity="top|start"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:hint="Add details..."
            android:padding="12dp"
            android:textColor="@color/primary_black"
            android:textColorHint="@color/neutral_slate"
            android:textSize="13sp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp" />

        <!-- Update Task Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdateTask"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_welcome_button"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="Update Task"
            android:textAllCaps="false"
            android:textColor="@color/surface_white"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Delete Task from Schedule Button (EXCLUSIVE LOCATION) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteTaskSchedule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_input"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="Delete Task from Schedule"
            android:textAllCaps="false"
            android:textColor="#BA1A1A"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
