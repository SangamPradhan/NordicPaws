<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".PetProfileListFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="120dp"
            android:paddingHorizontal="24dp">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bottom_nav"
                    android:src="@drawable/baseline_arrow_back_24"
                    android:padding="8dp"
                    app:tint="@color/primary_black"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Pets"
                        android:textColor="@color/primary_black"
                        android:textSize="20sp"
                        android:fontFamily="@font/plusjakartasansbold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 COMPANIONS REGISTERED"
                        android:textColor="@color/neutral_slate"
                        android:textSize="10sp"
                        android:fontFamily="@font/plusjakartasansbold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageButton
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bottom_nav"
                    android:src="@drawable/baseline_search_24"
                    android:padding="8dp"
                    app:tint="@color/primary_black"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_pet_profile" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOLISTIC CARE PROFILES FOR YOUR WHOLE FAMILY"
                android:textColor="@color/neutral_slate"
                android:textSize="10sp"
                android:textAlignment="center"
                android:fontFamily="@font/plusjakartasansbold"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button — Add New Pet -->
    <!-- Floating Action Button — Add New Pet -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddPet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="100dp"
        android:contentDescription="Add new pet"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_black"
        app:tint="@color/surface_white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
