<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    tools:context=".PetProfileListFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="100dp"
        android:paddingHorizontal="24dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav"
                android:src="@drawable/baseline_arrow_back_24"
                android:padding="8dp"
                app:tint="@color/primary_black"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Pets"
                    android:textColor="@color/primary_black"
                    android:textSize="20sp"
                    android:fontFamily="@font/plusjakartasansbold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 COMPANIONS REGISTERED"
                    android:textColor="@color/neutral_slate"
                    android:textSize="10sp"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav"
                android:src="@drawable/baseline_search_24"
                android:padding="8dp"
                app:tint="@color/primary_black"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_pet_profile" />

        <!-- Add Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="Add New Pet"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:fontFamily="@font/plusjakartasanssemibold"
            app:backgroundTint="@color/primary_black"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOLISTIC CARE PROFILES FOR YOUR WHOLE FAMILY"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:textAlignment="center"
            android:fontFamily="@font/plusjakartasansbold"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
