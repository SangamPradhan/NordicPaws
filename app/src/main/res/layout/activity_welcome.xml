<?xml version="1.0" encoding="utf-8"?>

<!--
    Single-level ConstraintLayout.
    A horizontal Guideline at 42% keeps the text/button block in the
    upper portion and the dog image always fills the remaining space —
    no hard-coded pixel gaps, fully responsive.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_yellow"
    tools:context=".WelcomeActivity">

    <!-- Divides the screen: content lives above, dog lives below -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/contentDivider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.44" />

    <!-- ── LEFT SPARK ─────────────────────────────────────────────── -->

    <ImageView
        android:id="@+id/leftSpark"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_welcome_spark"
        app:layout_constraintBottom_toBottomOf="@id/smallTitle"
        app:layout_constraintEnd_toStartOf="@id/smallTitle"
        app:layout_constraintTop_toTopOf="@id/smallTitle" />

    <!-- ── SMALL HEADING ──────────────────────────────────────────── -->

    <!--
        Vertically centred in the top 44% band so spacing is
        proportional on every screen size (no marginTop in dp).
    -->
    <TextView
        android:id="@+id/smallTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plusjakartasanssemibold"
        android:text="@string/welcome_small_title"
        android:textColor="@color/primary_black"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/welcomeTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.38" />

    <!-- ── RIGHT SPARK ────────────────────────────────────────────── -->

    <ImageView
        android:id="@+id/right_spark"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:rotation="90"
        android:src="@drawable/ic_welcome_spark"
        app:layout_constraintBottom_toBottomOf="@id/smallTitle"
        app:layout_constraintStart_toEndOf="@id/smallTitle"
        app:layout_constraintTop_toTopOf="@id/smallTitle" />

    <!-- ── MAIN HEADING ───────────────────────────────────────────── -->

    <TextView
        android:id="@+id/welcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/plusjakartasbold"
        android:includeFontPadding="false"
        android:text="@string/welcome_title"
        android:textColor="@color/primary_black"
        android:textSize="54sp"
        app:layout_constraintBottom_toTopOf="@id/getStartedButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/smallTitle" />

    <!-- ── GET STARTED BUTTON ─────────────────────────────────────── -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/getStartedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="56dp"
        app:backgroundTint="@color/primary_black"
        android:fontFamily="@font/plusjakartasanssemibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="54dp"
        android:text="@string/get_started"
        android:textAllCaps="false"
        android:textColor="@color/surface_white"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/contentDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeTitle" />

    <!-- ── DOG IMAGE — fills everything below the guideline ──────── -->

    <ImageView
        android:id="@+id/dog_welcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/dog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/getStartedButton" />

</androidx.constraintlayout.widget.ConstraintLayout>