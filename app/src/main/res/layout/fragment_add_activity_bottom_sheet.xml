<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Handle bar -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_logo_circle"
            android:backgroundTint="#CBD5E1" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plusjakartasansbold"
                android:text="Add Activity"
                android:textColor="@color/primary_black"
                android:textSize="20sp" />

            <!-- Pet Switcher Banner Pill -->
            <LinearLayout
                android:id="@+id/petSelectorPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/selectedPetAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dog" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/selectedPetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="Milo"
                    android:textColor="@color/primary_black"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/baseline_more_vert_24"
                    app:tint="@color/neutral_slate" />
            </LinearLayout>
        </LinearLayout>



        <!-- Recurrence Options (Daily, Weekly, Monthly, Specific Date) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="RECURRENCE PATTERN"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRecurrenceDaily"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_bottom_nav"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Daily"
                    android:textColor="@color/neutral_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnRecurrenceWeekly"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_input"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Weekly"
                    android:textColor="@color/neutral_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnRecurrenceMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_rounded_input"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Monthly"
                    android:textColor="@color/neutral_slate"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnRecurrenceSpecificDate"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_rounded_input"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Specific Date (Vet/One-time)"
                    android:textColor="@color/neutral_slate"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Dynamic Date Selector Pill (For Specific Date / Monthly) -->
        <LinearLayout
            android:id="@+id/datePickerPill"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_rounded_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/baseline_event_note_24"
                app:tint="@color/neutral_slate" />

            <TextView
                android:id="@+id/tvScheduledDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plusjakartasansbold"
                android:text="Select Date"
                android:textColor="@color/primary_black"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Dynamic Bulk Tasks List Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plusjakartasansbold"
                android:text="TASKS TO ADD (BULK LIST)"
                android:textColor="@color/neutral_slate"
                android:textSize="10sp"
                android:letterSpacing="0.05" />

            <!-- Add More Task Button -->
            <LinearLayout
                android:id="@+id/btnAddMoreTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_input"
                android:backgroundTint="#E2E8F0"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/primary_black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/plusjakartasansbold"
                    android:text="Add Another Task"
                    android:textColor="@color/primary_black"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Container for Dynamic Task Rows -->
        <LinearLayout
            android:id="@+id/bulkTasksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <!-- Dynamically populated item_bulk_task_row views -->
        </LinearLayout>

        <!-- Routine Impact Delight Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#F0F4FF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/baseline_health_and_safety_24"
                    app:tint="@color/primary_black" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasansbold"
                        android:text="Holistic Routine Impact"
                        android:textColor="@color/primary_black"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:text="Consistent routine tasks improve pet health &amp; longevity."
                        android:textColor="@color/neutral_slate"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Save Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveTask"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_welcome_button"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="Save All Tasks"
            android:textAllCaps="false"
            android:textColor="@color/surface_white"
            android:textSize="16sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
