<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    tools:context=".SignUpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- ══════════════════════════════════════════════════════════
             TOP BAR  — back button on left, badge on right
             ══════════════════════════════════════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_logo_circle"
                android:contentDescription="Go back"
                android:padding="10dp"
                android:src="@drawable/baseline_arrow_back_24"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/stepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_care_portal"
                android:fontFamily="@font/plusjakartasbold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="• STEP 1 OF 2"
                android:textColor="@color/primary_black"
                android:textSize="10sp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- ══════════════════════════════════════════════════════════
             HEADER
             ══════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="Nurture &amp; Care"
            android:textColor="@color/secondary_yellow"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/plusjakartasbold"
            android:includeFontPadding="false"
            android:text="Create Account"
            android:textColor="@color/primary_black"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="Start your pet wellness journey today"
            android:textColor="@color/neutral_slate"
            android:textSize="14sp" />

        <!-- ══════════════════════════════════════════════════════════
             FORM
             ══════════════════════════════════════════════════════════ -->

        <!-- FULL NAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="Full Name"
            android:textColor="@color/primary_black"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.NordicPaws.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Alex Morgan"
            app:boxBackgroundColor="@color/surface_white"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_person_circle"
            app:startIconTint="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:inputType="textPersonName"
                android:minHeight="54dp"
                android:paddingStart="4dp"
                android:textColor="@color/primary_black"
                android:textColorHint="#B6B6B6"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- EMAIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="Email Address"
            android:textColor="@color/primary_black"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.NordicPaws.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="alex@example.com"
            app:boxBackgroundColor="@color/surface_white"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_email_circle"
            app:startIconTint="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:inputType="textEmailAddress"
                android:minHeight="54dp"
                android:paddingStart="4dp"
                android:textColor="@color/primary_black"
                android:textColorHint="#B6B6B6"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="Password"
            android:textColor="@color/primary_black"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.NordicPaws.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="••••••••••••"
            app:boxBackgroundColor="@color/surface_white"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/neutral_slate"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_lock_circle"
            app:startIconTint="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/plusjakartasansegular"
                android:inputType="textPassword"
                android:minHeight="54dp"
                android:paddingStart="4dp"
                android:textColor="@color/primary_black"
                android:textColorHint="#B6B6B6"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONFIRM PASSWORD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="Confirm Password"
            android:textColor="@color/primary_black"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.NordicPaws.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="••••••••••••"
            app:boxBackgroundColor="@color/surface_white"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/neutral_slate"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_lock_circle"
            app:startIconTint="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/plusjakartasansegular"
                android:inputType="textPassword"
                android:minHeight="54dp"
                android:paddingStart="4dp"
                android:textColor="@color/primary_black"
                android:textColorHint="#B6B6B6"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TERMS AND CONDITIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary_black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="I agree to the Terms &amp; Privacy Policy"
                android:textColor="@color/neutral_slate"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CREATE ACCOUNT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:backgroundTint="@color/primary_black"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="58dp"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textColor="@color/surface_white"
            android:textSize="16sp"
            app:cornerRadius="29dp"
            app:elevation="0dp"
            app:icon="@drawable/baseline_arrow_forward_24"
            app:iconGravity="textEnd"
            app:iconTint="@color/surface_white" />

        <!-- ALREADY HAVE AN ACCOUNT -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:text="Already have an account? "
                android:textColor="@color/neutral_slate"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/loginText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plusjakartasanssemibold"
                android:text="Log In"
                android:textColor="@color/primary_black"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
