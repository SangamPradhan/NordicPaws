<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Handle bar -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_logo_circle"
            android:backgroundTint="#CBD5E1" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plusjakartasansbold"
                android:text="Add New Location"
                android:textColor="@color/primary_black"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Interactive Map Location Preview Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#EBF2FA">

                <!-- Center Map Pin Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_logo_circle"
                        android:backgroundTint="@color/secondary_yellow">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/paw"
                            app:tint="@color/primary_black" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_bottom_nav"
                        android:fontFamily="@font/plusjakartasansbold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Tap to adjust pin location"
                        android:textColor="@color/primary_black"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Place Name Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="PLACE NAME"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPlaceName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_input"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:hint="e.g. Whispering Pines Run"
            android:paddingHorizontal="16dp"
            android:textColor="@color/primary_black"
            android:textColorHint="@color/neutral_slate"
            android:textSize="14sp"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />

        <!-- Category Selector Chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="CATEGORY"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/placeCategoryChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Dynamic Chips populated in Fragment -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Address Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="ADDRESS"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPlaceAddress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_input"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:hint="Street address, city"
            android:paddingHorizontal="16dp"
            android:textColor="@color/primary_black"
            android:textColorHint="@color/neutral_slate"
            android:textSize="14sp"
            android:inputType="textPostalAddress"
            android:layout_marginBottom="16dp" />

        <!-- Care Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="CARE NOTES &amp; ACCESS (OPTIONAL)"
            android:textColor="@color/neutral_slate"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPlaceNotes"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/bg_rounded_input"
            android:gravity="top|start"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:hint="Add parking notes, gate codes, or favourite trails..."
            android:padding="12dp"
            android:textColor="@color/primary_black"
            android:textColorHint="@color/neutral_slate"
            android:textSize="13sp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp" />

        <!-- Save Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSavePlace"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_welcome_button"
            android:fontFamily="@font/plusjakartasansbold"
            android:text="Save Location"
            android:textAllCaps="false"
            android:textColor="@color/surface_white"
            android:textSize="16sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
