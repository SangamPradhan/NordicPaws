<resources>

    <style
        name="Widget.NordicPaws.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundColor">@color/surface_white</item>

        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">#E2E8F0</item>

        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>

        <item name="hintEnabled">false</item>

        <!-- Important: the drawable already contains its own circle -->
        <item name="startIconTint">@null</item>

    </style>

    <!--
        Login screen gets its own theme so the window background matches
        the layout background (bg_cream).  Without this, Android briefly
        shows the app-wide windowBackground (secondary_yellow) before
        setContentView() finishes drawing, producing a yellow → black flash.
    -->
    <style name="Theme.NordicPaws.Login" parent="Theme.NordicPaws">
        <item name="android:windowBackground">@color/bg_cream</item>
    </style>

    <!-- Account Details: slides up from bottom like a bottom sheet -->
    <style name="Theme.NordicPaws.BottomSheet" parent="Theme.NordicPaws">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.NordicPaws.BottomSheet</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Animation.NordicPaws.BottomSheet" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!-- Notifications: slides down from top -->
    <style name="Theme.NordicPaws.TopSheet" parent="Theme.NordicPaws">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.NordicPaws.TopSheet</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Animation.NordicPaws.TopSheet" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_down_enter</item>
        <item name="android:windowExitAnimation">@anim/slide_up_exit</item>
    </style>

</resources>